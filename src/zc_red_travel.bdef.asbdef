projection;
strict ( 2 );

define behavior for zc_red_travel //alias <alias_name>
use etag
{
  use create;
  use update;
  use delete;
  use action copyTravel;
  use association _Booking { create; }
}

define behavior for zc_booking_projection //alias <alias_name>
use etag
{
  use update;
  use delete;

  use association _Travel;
  use association _supply { create; }
}

define behavior for zc_supply_projection //alias <alias_name>
use etag
{
  use update;
  use delete;

  use association _Travel;
  use association _Booking;
}